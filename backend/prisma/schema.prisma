// Prisma schema for Glow Studio - a single hair/beauty salon.
//
// Assumption: one physical location, one shared calendar (no multi-tenancy,
// no multi-stylist resource scheduling) - every appointment blocks the same
// salon-wide timeline.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppointmentStatus {
  pending
  confirmed
  cancelled
}

enum ChatRole {
  user
  assistant
}

enum UserRole {
  customer
  admin
}

enum AuthProvider {
  local
  google
  facebook
}

enum ServiceCategory {
  hair
  skin
  nails
  body_spa
  makeup
  grooming
}

enum NotificationType {
  booking_requested
  booking_confirmed
  booking_cancelled
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  // Nullable: OAuth-only accounts (Google/Facebook) never set a password.
  passwordHash String?       @map("password_hash")
  name         String
  role         UserRole      @default(customer)
  provider     AuthProvider  @default(local)
  providerId   String?       @map("provider_id")
  createdAt    DateTime      @default(now()) @map("created_at")

  appointments  Appointment[]
  chatSessions  ChatSession[]
  notifications Notification[]

  @@map("users")
}

model Service {
  id              String          @id @default(uuid())
  name            String          @unique
  category        ServiceCategory
  description     String?
  durationMinutes Int             @map("duration_minutes")
  price           Float
  isActive        Boolean         @default(true) @map("is_active")
  createdAt       DateTime        @default(now()) @map("created_at")

  appointments Appointment[]

  @@index([category])
  @@map("services")
}

// One row per weekday (0 = Sunday ... 6 = Saturday). Flat weekly schedule,
// no special-date/holiday overrides.
model BusinessHours {
  id        String  @id @default(uuid())
  dayOfWeek Int     @unique @map("day_of_week")
  openTime  String  @map("open_time") // "HH:mm"
  closeTime String  @map("close_time") // "HH:mm"
  isClosed  Boolean @default(false) @map("is_closed")

  @@map("business_hours")
}

model Appointment {
  id          String            @id @default(uuid())
  userId      String            @map("user_id")
  serviceId   String            @map("service_id")
  scheduledAt DateTime          @map("scheduled_at")
  status      AppointmentStatus @default(pending)
  notes       String?
  // Only ever set when an admin cancels - shown back to the customer so
  // "why was my booking cancelled" has an answer.
  cancellationReason String?    @map("cancellation_reason")
  createdAt   DateTime          @default(now()) @map("created_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  service       Service        @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  notifications Notification[]

  @@index([userId, scheduledAt])
  @@index([scheduledAt])
  @@map("appointments")
}

model ChatSession {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@map("chat_sessions")
}

model ChatMessage {
  id          String   @id @default(uuid())
  sessionId   String   @map("session_id")
  role        ChatRole
  content     String
  // Structured extraction from the AI service for assistant messages
  // (intent/service/date/time/isComplete) - nullable because user messages
  // never have it, and older rows may predate a metadata shape change.
  aiMetadata  Json?    @map("ai_metadata")
  createdAt   DateTime @default(now()) @map("created_at")

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("chat_messages")
}

// One row per recipient per event - a new booking fans out to every admin
// as a separate row, rather than one shared row with read-state per user.
model Notification {
  id            String           @id @default(uuid())
  userId        String           @map("user_id")
  type          NotificationType
  message       String
  appointmentId String?          @map("appointment_id")
  isRead        Boolean          @default(false) @map("is_read")
  createdAt     DateTime         @default(now()) @map("created_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([userId, isRead])
  @@map("notifications")
}
