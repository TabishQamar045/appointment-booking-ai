# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/appointment_booking?schema=public"

# Signing secret for JWTs (auth cookie). Use a long random string in production.
JWT_SECRET="change-me-to-a-long-random-string"

# How long an auth session lasts
JWT_EXPIRES_IN="7d"

# Mistral API key - https://console.mistral.ai/
MISTRAL_API_KEY="your-mistral-api-key"

# Mistral model to use for chat completions
MISTRAL_MODEL="mistral-small-latest"

# Port the Express server listens on
PORT=4100

# Origin allowed to make credentialed requests (the frontend's URL)
FRONTEND_ORIGIN="http://localhost:3000"

# development | production - affects cookie `secure` flag and error verbosity
NODE_ENV="development"
