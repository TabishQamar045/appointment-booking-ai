# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/appointment_booking?schema=public"

# Signing secret for JWTs (auth cookie). Use a long random string in production.
JWT_SECRET="change-me-to-a-long-random-string"

# How long an auth session lasts
JWT_EXPIRES_IN="7d"

# Groq API key (free, no card required) - https://console.groq.com/keys
GROQ_API_KEY="your-groq-api-key"

# Groq model to use for chat completions
GROQ_MODEL="llama-3.3-70b-versatile"

# Port the Express server listens on
PORT=4100

# Origin allowed to make credentialed requests (the frontend's URL)
FRONTEND_ORIGIN="http://localhost:3000"

# development | production - affects cookie `secure` flag and error verbosity
NODE_ENV="development"
