# Copy to .env.test for running the backend test suite locally
# (npm test). CI supplies these as real environment variables instead of
# this file - see .github/workflows/test.yml.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/appointment_booking_test?schema=public"
JWT_SECRET="test-only-secret"
JWT_EXPIRES_IN="7d"
GROQ_API_KEY="test-key-never-actually-called"
GROQ_MODEL="openai/gpt-oss-120b"
PORT=4101
FRONTEND_ORIGIN="http://localhost:3000"
NODE_ENV="test"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
