# Base URL of the backend Express API. Server-side only (not NEXT_PUBLIC_):
# Next.js rewrites (see next.config.ts) proxy /auth, /appointments, /chat
# through this frontend's own domain so the browser only ever talks to one
# origin, keeping the auth cookie first-party even when frontend and backend
# are deployed on different domains.
BACKEND_URL="http://localhost:4100"
